---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => (b.data.year - a.data.year) || (a.data.order - b.data.order));
---
<BaseLayout title="Work · Bryan Bartley">
  <h1 class="display text-6xl mb-4">work<span class="dot">.</span></h1>
  <p class="text-muted mb-14">Live products, shipped projects, and active builds.</p>

  <ul class="space-y-10">
    {projects.map((p) => (
      <li>
        <a href={`/work/${p.id}`} class="group block no-underline">
          <div class="flex items-baseline justify-between gap-4 mb-1">
            <h2 class="flex items-baseline gap-2 text-lg font-semibold tracking-[-0.01em]">
              <span class="group-hover:text-accent">{p.data.title}</span>
              <span data-ink="arrow" data-ink-color="accent" data-ink-draw="hover" class="inline-block w-9 h-3 shrink-0"></span>
            </h2>
            <span class="font-mono text-xs text-muted whitespace-nowrap">{p.data.year} · {p.data.status}</span>
          </div>
          <p class="text-muted">{p.data.tagline}</p>
          {p.data.stack.length > 0 && (
            <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
              {p.data.stack.map((s) => (
                <span class="font-mono text-xs text-muted">{s}</span>
              ))}
            </div>
          )}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
