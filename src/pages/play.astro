---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('play'))
  .sort((a, b) => {
    const orderDiff = a.data.order - b.data.order;
    if (orderDiff !== 0) return orderDiff;
    return (b.data.year ?? 0) - (a.data.year ?? 0);
  });
---
<BaseLayout title="Play — Bryan Bartley" description="Side projects and curiosities. Games, sprites, AI experiments, gacha machines, music tools.">
  <h1 class="text-3xl font-medium mb-2">Play</h1>
  <p class="text-muted max-w-xl leading-relaxed">
    Side projects and curiosities. None of it is billable. Some of it
    works. The rest taught me something.
  </p>
  <p class="text-sm text-muted mt-3 mb-12">
    My songs live on Suno → <a href="https://suno.com/@buhhhryan?page=songs" class="underline decoration-rule hover:decoration-accent">@buhhhryan</a>
  </p>

  {items.length === 0 ? (
    <p class="text-muted">Nothing here yet.</p>
  ) : (
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
      {items.map((item) => {
        const Wrapper = item.data.url ? 'a' : 'div';
        const wrapperProps = item.data.url
          ? { href: item.data.url, class: 'group block break-inside-avoid mb-6 no-underline' }
          : { class: 'block break-inside-avoid mb-6' };
        return (
          <Wrapper {...wrapperProps}>
            {item.data.image ? (
              <div class="border border-rule overflow-hidden">
                <img
                  src={item.data.image}
                  alt={item.data.title}
                  loading="lazy"
                  class={`w-full h-auto block ${item.data.url ? 'group-hover:opacity-90 transition-opacity' : ''}`}
                />
              </div>
            ) : (
              <div class="border border-rule aspect-[4/3] flex items-center justify-center bg-rule/30">
                <span class="font-mono text-xs uppercase tracking-wider text-muted">image pending</span>
              </div>
            )}
            <div class="mt-3 flex items-baseline justify-between gap-3">
              <h3 class={`font-medium ${item.data.url ? 'group-hover:text-accent' : ''}`}>{item.data.title}</h3>
              {item.data.year && <span class="font-mono text-xs text-muted">{item.data.year}</span>}
            </div>
            <p class="text-sm text-muted leading-relaxed mt-1">{item.data.caption}</p>
          </Wrapper>
        );
      })}
    </div>
  )}
</BaseLayout>
