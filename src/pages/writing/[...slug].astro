---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pieces = await getCollection('writing', ({ data }) => !data.draft);
  return pieces.map((p) => ({ params: { slug: p.id }, props: { piece: p } }));
}

const { piece } = Astro.props;
const { Content } = await render(piece);
const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<BaseLayout title={`${piece.data.title} · Bryan Bartley`} description={piece.data.excerpt}>
  <a href="/writing" class="font-mono text-sm text-muted hover:text-accent no-underline">← writing</a>
  <header class="mt-6 mb-4">
    <h1 class="text-4xl font-semibold tracking-[-0.03em] mb-3 leading-tight">{piece.data.title}</h1>
    <p class="font-mono text-xs text-muted">
      {fmt.format(piece.data.date)}
      {piece.data.category && <span> · {piece.data.category}</span>}
    </p>
  </header>
  <div data-ink="rule" data-ink-size="1.6" class="h-3 mb-10"></div>
  <article class="prose-bb">
    <Content />
  </article>
</BaseLayout>
