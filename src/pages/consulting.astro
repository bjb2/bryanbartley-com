---
import BaseLayout from '../layouts/BaseLayout.astro';

const results = [
  { n: '8×', label: 'monthly leads in four months' },
  { n: '−60%', label: 'cost per lead, same client' },
  { n: '100K+', label: "users on vidIQ's AI Coach, which I took to market" },
  { n: '+50%', label: 'checkout conversion after I rebuilt vidIQ payments' },
];

const offers = [
  'Paid acquisition on Meta and Google, built from zero or taken over mid-flight by someone who reads the raw numbers instead of trusting the ad platform’s version of events.',
  'AI features and internal tools that ship.',
  'Tracking checked at the source. Your dashboard stops lying to you.',
  'Or all of it: one person instead of three vendors.',
];

const testimonials = [
  {
    quote: "Bryan is incredible to work with. I don't know anyone that had more skills or the ability to roll their own sleeves up to get stuff done! Highly recommended.",
    name: 'Spencer Little',
    company: 'Deluxe Garages',
  },
  {
    quote: "I had an urgent CRM project, and Bryan was instrumental in helping me select the right tools for the job. His expertise and guidance made a significant difference, and I was thrilled to have the project delivered a week early! I couldn't have asked for better support.",
    name: 'Chad Kramer',
    company: 'GrayStone Insurance',
  },
];

const call = 'https://tidycal.com/bbartley/30-minute-meeting';
const mail = 'bryan@fivewhys.org';
---
<BaseLayout
  title="Five Whys · AI and growth consulting for early-stage teams"
  description="Growth and AI tooling for early-stage teams, from someone who checks the math."
  brand="fw"
>
  <section class="mb-20">
    <p class="label mb-5">Five Whys · consulting</p>
    <h1 class="text-4xl sm:text-5xl font-semibold tracking-[-0.035em] leading-[1.05] mb-6 text-balance">
      Growth and AI tooling for <span class="whitespace-nowrap">early-stage</span> teams, from someone who
      <span class="whitespace-nowrap"><span data-ink="underline" data-ink-color="gilt" data-ink-delay="300">checks the math</span><span class="dot">.</span></span>
    </h1>
    <p class="text-lg leading-relaxed text-muted max-w-2xl">
      I ran business operations at vidIQ, then went out on my own.
      <a href="/work/ai-platform-gtm" class="text-ink underline decoration-gilt decoration-2 underline-offset-4 hover:text-accent">My latest client</a>
      started with an empty ad account. Four months later they had eight times the monthly leads, and each one cost 60% less.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href={call} class="inline-block px-5 py-2.5 bg-ink text-paper text-sm font-medium no-underline hover:bg-accent transition-colors">
        Book a 30-min call →
      </a>
      <a href={`mailto:${mail}`} class="inline-block px-4 py-2 text-sm font-mono no-underline hover:text-accent" data-ink="box" data-ink-size="1.6" data-ink-draw="none">
        {mail}
      </a>
    </div>
  </section>

  <section class="mb-20 relative">
    <h2 class="label mb-8">Recent results</h2>
    <div class="grid grid-cols-2 gap-x-8 gap-y-10">
      {results.map((r, i) => (
        <div>
          <div class:list={['display text-5xl sm:text-6xl', i === 0 ? 'text-gilt' : 'text-ink']}>{r.n}</div>
          <p class="text-sm text-muted mt-3 max-w-[16rem] leading-snug">{r.label}</p>
        </div>
      ))}
    </div>
    <div class="hidden lg:flex absolute -right-44 top-10 w-48 items-start gap-1" aria-hidden="true">
      <div data-ink="arrow" data-ink-color="accent" data-ink-from="0.95,0.9" data-ink-to="0.05,0.25" data-ink-bend="-0.25" data-ink-delay="400" class="h-12 w-12 shrink-0"></div>
      <p class="hand text-[1.5rem] text-accent rotate-2 mt-7 leading-[0.95]">client unnamed.<br />numbers real.</p>
    </div>
  </section>

  <section class="mb-20">
    <h2 class="label mb-6">What I do</h2>
    <ul class="space-y-4">
      {offers.map((o, i) => (
        <li class="flex gap-4">
          <span class="font-mono text-xs text-gilt pt-1.5">0{i + 1}</span>
          <span class:list={['leading-relaxed', i === offers.length - 1 ? 'font-semibold' : '']}>{o}</span>
        </li>
      ))}
    </ul>
    <p class="text-sm text-muted mt-8 leading-relaxed max-w-xl">
      Month to month, and you can pause or end it whenever you want. Non-profits and employee-owned businesses get a reduced rate.
    </p>
  </section>

  <section class="mb-20">
    <h2 class="label mb-8">Past clients</h2>
    <div class="space-y-10">
      {testimonials.map((t) => (
        <blockquote class="pl-6 ml-1" data-ink="vline" data-ink-color="gilt" data-ink-size="2.2">
          <p class="leading-relaxed">“{t.quote}”</p>
          <footer class="mt-3 font-mono text-xs text-muted">
            {t.name}, {t.company}
          </footer>
        </blockquote>
      ))}
    </div>
  </section>

  <section>
    <h2 class="label mb-4">Start with a 30-min call</h2>
    <p class="leading-relaxed text-muted mb-7 max-w-xl">
      No deck. No pitch. Tell me what you're trying to ship, and if I'm not the right person for it, I'll usually know who is.
    </p>
    <div class="flex flex-wrap items-center gap-4">
      <a href={call} class="inline-block px-5 py-2.5 bg-ink text-paper text-sm font-medium no-underline hover:bg-accent transition-colors">
        Book a 30-min call →
      </a>
      <a href={`mailto:${mail}`} class="inline-block px-4 py-2 text-sm font-mono no-underline hover:text-accent" data-ink="box" data-ink-size="1.6" data-ink-draw="none">
        {mail}
      </a>
    </div>
  </section>
</BaseLayout>
